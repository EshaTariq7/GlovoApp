<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Back Arrow Button -->

    <!-- Orders Text -->
    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="@drawable/arrow_back" />

    <TextView
        android:id="@+id/orders_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Orders"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp" />

    <!-- Centered Image -->

    <!-- Text below the image -->

    <ImageView
        android:id="@+id/orders_image"
        android:layout_width="wrap_content"
        android:layout_height="392dp"
        android:layout_below="@id/orders_title"
        android:layout_marginTop="40dp"
        android:contentDescription="Orders Icon"
        android:scaleType="fitCenter"
        android:src="@drawable/human" />

    <TextView
        android:id="@+id/orders_text"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/orders_image"
        android:layout_marginTop="31dp"
        android:text="See your past and ongoing orders"
        android:textColor="#000000"
        android:textSize="25sp" />

</RelativeLayout>
